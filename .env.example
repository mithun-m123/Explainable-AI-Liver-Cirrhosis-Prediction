# ─────────────────────────────────────────────────────────────────────────────
# Liver Cirrhosis Detection System — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your own values below (never commit .env to git)
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=True
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR


# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no setup required):
DATABASE_URL=sqlite:///./liver_cirrhosis.db

# PostgreSQL (uncomment and fill in for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/liver_cirrhosis


# ── Authentication ────────────────────────────────────────────────────────────
# Change this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24


# ── File Storage ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
MODELS_DIR=./models
REPORTS_DIR=./reports


# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_CHATBOT=True
ENABLE_PDF_EXPORT=True
ENABLE_ANALYTICS=True


# ── Optional: LLM API Keys ────────────────────────────────────────────────────
# Required only if you enable the AI-powered chatbot with an external LLM.
# Leave blank to use the built-in rule-based fallback (no API key needed).

# Groq (free tier available — https://console.groq.com)
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
