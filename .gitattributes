# Normalise line endings to LF in the repository; check out as native on Windows
* text=auto eol=lf

# Explicitly text files
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.env*  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary files — never diff or merge
*.pkl   binary
*.h5    binary
*.pt    binary
*.pth   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
