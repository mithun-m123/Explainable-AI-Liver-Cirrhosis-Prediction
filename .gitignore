
# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Liver Cirrhosis Detection System
# ─────────────────────────────────────────────────────────────────────────────

# Secrets and local configuration
.env
.env.*
!.env.example
*.env.local
*.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Databases
*.db
*.sqlite
*.sqlite3

# Generated reports
backend/reports/*.pdf
reports/*.pdf

# Uploaded files
uploads/

# Logs
*.log
logs/

# Node and frontend
node_modules/
frontend/node_modules/
.npm
.eslintcache
frontend/build/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Docker runtime
.docker/

# Machine learning model binaries
backend/models/*.pkl
backend/models/*.h5
backend/models/*.pt
backend/models/*.pth
backend/models/retrained_candidate/
!backend/models/*.json

# Datasets and downloaded archives
datasets/
*.zip
*.kaggle-partial

# Training artifacts
wandb/
mlruns/
lightning_logs/
checkpoints/
*.ckpt
tensorboard_logs/

# Miscellaneous
*.tmp
*.bak
*.orig
pip-log.txt

# Ignore all datasets and their contents
datasets/